<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>

<VBox fx:id="root" spacing="15" stylesheets="@/calendar.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.Evenement.CalendarViewController">
    <HBox spacing="15" alignment="CENTER">
        <Button fx:id="prevMonthButton" text="Mois précédent" onAction="#onPreviousMonth" styleClass="nav-button" />
        <Label fx:id="monthYearLabel" styleClass="month-year-label" />
        <Button fx:id="nextMonthButton" text="Mois suivant" onAction="#onNextMonth" styleClass="nav-button" />
    </HBox>
    <GridPane fx:id="calendarGrid" hgap="4" vgap="4" styleClass="calendar-grid" />
    <ListView fx:id="eventListView" styleClass="event-list-view" prefHeight="150" />
    <Button fx:id="backButton" text="Retour" onAction="#onBackButtonClick" styleClass="back-button" />
</VBox>